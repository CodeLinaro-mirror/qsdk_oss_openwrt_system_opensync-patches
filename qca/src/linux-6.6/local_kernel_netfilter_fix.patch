+static inline bool br_is_promisc_packet(struct sk_buff *skb) {
+
+       switch (skb->protocol) {
+       case htons(ETH_P_IP): {
+               // Allow DHCP traffic
+               struct iphdr *l3_hdr = ip_hdr(skb);
+               if (l3_hdr->protocol == IPPROTO_UDP) {
+                       struct udphdr *l4_hdr = (struct udphdr *) ((char *)l3_hdr + l3_hdr->ihl * 4);
+                       if (ntohs(l4_hdr->source) == 67 || ntohs(l4_hdr->dest) == 67) {
+                               return true;
+                       }
+               }
+               return false;
+       }
+       case htons(ETH_P_IPV6): {
+               // Allow ICMPv6 traffic
+               struct ipv6hdr *l3_hdr = ipv6_hdr(skb);
+               if (l3_hdr->nexthdr == IPPROTO_ICMPV6) {
+                       return true;
+               }
+               return false;
+       }
+       case htons(ETH_P_ARP):
+               // Allow ARP traffic
+               return true;
+       }
+
+       return false;
+}
+
