diff --git a/net/netfilter/xt_skipaccel.c b/net/netfilter/xt_skipaccel.c
new file mode 100644
index 000000000000..75d6461cd1db
--- /dev/null
+++ b/net/netfilter/xt_skipaccel.c
@@ -0,0 +1,49 @@
+/*
+* Copyright (c) 2024, Qualcomm Innovation Center, Inc. All rights reserved.
+* SPDX-License-Identifier: ISC
+*/
+#include <linux/module.h>
+#include <linux/skbuff.h>
+#include <linux/netfilter/x_tables.h>
+
+MODULE_LICENSE("Dual BSD/GPL");
+
+MODULE_DESCRIPTION("xtables skip accel module");
+MODULE_ALIAS("xt_skipaccel");
+
+static unsigned int
+skipaccel_tg(struct sk_buff *skb, const struct xt_action_param *par)
+{
+  skb->dp_flags |= DP_FLAG_SKIPACCEL;
+  return XT_CONTINUE;
+}
+
+static struct xt_target skipaccel_tg_reg __read_mostly = {
+  .name = "skipaccel",
+  .revision = 0,
+  .family = NFPROTO_UNSPEC,
+  .target = skipaccel_tg,
+  .me = THIS_MODULE,
+};
+
+static struct xt_target skipaccel_br_tg_reg __read_mostly = {
+  .name = "skipaccel",
+  .revision = 0,
+  .family = NFPROTO_BRIDGE,
+  .target = skipaccel_tg,
+  .me = THIS_MODULE,
+};
+
+static int __init skipaccel_tg_init(void)
+{
+  return xt_register_target(&skipaccel_tg_reg) || xt_register_target(&skipaccel_br_tg_reg);
+}
+
+static void __exit skipaccel_tg_exit(void)
+{
+  xt_unregister_target(&skipaccel_tg_reg);
+  xt_unregister_target(&skipaccel_br_tg_reg);
+}
+
+module_init(skipaccel_tg_init);
+module_exit(skipaccel_tg_exit);
--
