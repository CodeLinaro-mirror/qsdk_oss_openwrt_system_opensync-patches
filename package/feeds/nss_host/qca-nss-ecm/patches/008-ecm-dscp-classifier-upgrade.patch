-			dscpcte->reply_mark =  skb->mark;
-			dscpcte->reply_dscp = iph->ds >> XT_DSCP_SHIFT;
-			dscpcte->return_set_flags = NF_CT_DSCPREMARK_EXT_PRIO | NF_CT_DSCPREMARK_EXT_DSCP | NF_CT_DSCPREMARK_EXT_MARK;
