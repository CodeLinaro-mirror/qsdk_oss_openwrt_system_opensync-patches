From: Murat Sezgin <quic_msezgin@quicinc.com>
Date: Thu, 26 Sep 2024 13:10:14 +0530
Subject: [PATCH] Add support for various fixes in nss drivers

Even though ECM says acceleration for multicast traffic flowing through
GRE tap tunnels is not supported, it is working just fine when SFE
acceleration engine is used. This patch therefore enables multicast
acceleration through GRE taps specifically for SFE.

Signed-off-by: Deepak Kumar <quic_deepaku@quicinc.com>
--- a/ecm_interface.c
+++ b/ecm_interface.c
@@ -3957,8 +3957,8 @@ static uint32_t ecm_interface_multicast_
 				 * Ethernet - but what sub type?
 				 */
 #ifdef ECM_INTERFACE_GRE_TAP_ENABLE
-				if (dest_dev->priv_flags_ext & (IFF_EXT_GRE_V4_TAP | IFF_EXT_GRE_V6_TAP)) {
-					DEBUG_TRACE("%px: Acceleration not supported for GRE tap flows\n", dest_dev);
+				if (dest_dev->priv_flags_ext & (IFF_EXT_GRE_V4_TAP | IFF_EXT_GRE_V6_TAP) && feci->accel_engine != ECM_FRONT_END_ENGINE_SFE) {
+					DEBUG_TRACE("%px: Acceleration for GRE tap flows is only supported by SFE acceleration engine.\n", dest_dev);
 					dev_put(dest_dev);
 					ecm_db_multicast_copy_if_heirarchy(to_list_single, interface);
 					ecm_db_connection_interfaces_deref(to_list_single, current_interface_index);
@@ -6134,8 +6134,8 @@ int32_t ecm_interface_multicast_from_hei
 				 */
 
 #ifdef ECM_INTERFACE_GRE_TAP_ENABLE
-				if (dest_dev->priv_flags_ext & (IFF_EXT_GRE_V4_TAP | IFF_EXT_GRE_V6_TAP)) {
-					DEBUG_TRACE("%px: Acceleration not supported for GRE tap flows.\n", dest_dev);
+				if (dest_dev->priv_flags_ext & (IFF_EXT_GRE_V4_TAP | IFF_EXT_GRE_V6_TAP) && feci->accel_engine != ECM_FRONT_END_ENGINE_SFE) {
+					DEBUG_TRACE("%px: Acceleration for GRE tap flows is only supported by SFE acceleration engine.\n", dest_dev);
 					dev_put(src_dev);
 					dev_put(dest_dev);
 					ecm_db_connection_interfaces_deref(interfaces, current_interface_index);
