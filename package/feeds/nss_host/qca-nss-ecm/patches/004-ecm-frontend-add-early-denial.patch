+
 	/*
 	 * If operations have stopped then do not process packets
 	 */
@@ -1786,6 +1794,14 @@ static unsigned int ecm_ipv6_bridge_post_routing_hook(void *priv,
 
 	DEBUG_TRACE("%px: IPv6 CMN Bridge: %s\n", out, out->name);
 
+	/*
+	 * Early acceleration skip?
+	 */
+	if (ecm_front_end_early_denial(skb) == true) {
+		DEBUG_TRACE("Early denial hit\n");
+		return NF_ACCEPT;
