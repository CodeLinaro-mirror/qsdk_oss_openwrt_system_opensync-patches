From 832218aa47c4b808d46c439831991bc1905226f8 Mon Sep 17 00:00:00 2001
From: Murat Sezgin <quic_msezgin@quicinc.com>
Date: Thu, 26 Sep 2024 13:10:14 +0530
Subject: [PATCH] Add support for various fixes in nss drivers

Signed-off-by: Deepak Kumar <quic_deepaku@quicinc.com>

--- a/frontends/include/ecm_front_end_common.h
+++ b/frontends/include/ecm_front_end_common.h
@@ -386,6 +386,20 @@ static inline bool ecm_front_end_ppppoe_br_accel_3tuple(void)
 	return ret;
 }
 
+/*
+ * ecm_front_end_early_denial()
+ *      Check if packet was marked for acceleration skip.
+ */
+static inline bool ecm_front_end_early_denial(struct sk_buff *skb)
+{
+	/* Was this marked for accel skip with xtables? */
+	if (skb->dp_flags & DP_FLAG_SKIPACCEL) {
+		return true;
+	}
+
+	return false;
+}
+
 extern void ecm_front_end_bond_notifier_stop(int num);
 extern int ecm_front_end_bond_notifier_init(struct dentry *dentry);
 extern void ecm_front_end_bond_notifier_exit(void);
--- a/frontends/cmn/ecm_ipv4.c
+++ b/frontends/cmn/ecm_ipv4.c
@@ -1608,6 +1608,14 @@ static unsigned int ecm_ipv4_post_routing_hook(void *priv,
 
 	DEBUG_TRACE("%px: IPv4 CMN Routing: %s skb=%px\n", out, out->name, skb);
 
+	/*
+	 * Early acceleration skip?
+	 */
+	if (ecm_front_end_early_denial(skb) == true) {
+		DEBUG_TRACE("Early denial hit\n");
+		return NF_ACCEPT;
+	}
+
 	/*
 	 * If operations have stopped then do not process packets
 	 */
@@ -1803,6 +1811,14 @@ static unsigned int ecm_ipv4_bridge_post_routing_hook(void *priv,
 
 	DEBUG_TRACE("%px: IPv4 CMN Bridge: %s skb=%px\n", out, out->name, skb);
 
+	/*
+	 * Early acceleration skip?
+	 */
+	if (ecm_front_end_early_denial(skb) == true) {
+		DEBUG_TRACE("Early denial hit\n");
+		return NF_ACCEPT;
+	}
+
 	/*
 	 * If operations have stopped then do not process packets
 	 */
