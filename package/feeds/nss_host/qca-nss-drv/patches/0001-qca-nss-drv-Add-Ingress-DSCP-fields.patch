@@ -100,6 +102,7 @@ struct nss_stats_info nss_ipv4_strings_exception_stats[NSS_IPV4_EXCEPTION_EVENT_
 	{"udplite_ip_fragment"			, NSS_STATS_TYPE_EXCEPTION},
