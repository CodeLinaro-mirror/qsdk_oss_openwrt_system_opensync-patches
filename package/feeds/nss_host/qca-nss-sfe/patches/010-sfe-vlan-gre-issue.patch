From: Murat Sezgin <quic_msezgin@quicinc.com>
Date: Thu, 26 Sep 2024 13:10:14 +0530
Subject: [PATCH] Add support for various fixes in nss drivers

When we have qdisc being configured in more than one interface and VLAN is the top interface, we will add L2 header.

Change-Id: Ib2b4df05c66d010b62117f1b26cb9a6cf2f26113
Signed-off-by: Deepak Kumar <quic_deepaku@quicinc.com>
---
 sfe_ipv4.c | 32 ++++++++++++++++++++++++++++++++
 sfe_ipv6.c | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+)

diff --git a/sfe_ipv4.c b/sfe_ipv4.c
index 98aa4be21..712478486 100644
--- a/sfe_ipv4.c
+++ b/sfe_ipv4.c
@@ -3188,6 +3188,38 @@ int sfe_ipv4_create_rule(struct sfe_ipv4_rule_create_msg *msg)
 		}
 	}
 
+	if (disable_l2_flow) {
+		if (!reply_cm->top_interface_dev || is_vlan_dev(reply_cm->top_interface_dev)) {
+			reply_cm->flags |= SFE_IPV4_CONNECTION_MATCH_FLAG_WRITE_L2_HDR;
+
+			/*
+			 * If our dev writes Ethernet headers then we can write a really fast
+			 * version.
+			 */
+			if (src_dev->header_ops) {
+				if (src_dev->header_ops->create == eth_header) {
+					reply_cm->flags |= SFE_IPV4_CONNECTION_MATCH_FLAG_WRITE_FAST_ETH_HDR;
+				}
+			}
+		}
+	}
+
+	if (disable_l2_return) {
+		if (!original_cm->top_interface_dev || is_vlan_dev(original_cm->top_interface_dev)) {
+			original_cm->flags |= SFE_IPV4_CONNECTION_MATCH_FLAG_WRITE_L2_HDR;
+
+			/*
+			 * If our dev writes Ethernet headers then we can write a really fast
+			 * version.
+			 */
+			if (dest_dev->header_ops) {
+				if (dest_dev->header_ops->create == eth_header) {
+					original_cm->flags |= SFE_IPV4_CONNECTION_MATCH_FLAG_WRITE_FAST_ETH_HDR;
+				}
+			}
+		}
+	}
+
 #ifdef SFE_BRIDGE_VLAN_FILTERING_ENABLE
 	/*
 	 * Add Bridge VLAN Filter rule in reply_cm
diff --git a/sfe_ipv6.c b/sfe_ipv6.c
index 46347f97c..f2263b11b 100644
--- a/sfe_ipv6.c
+++ b/sfe_ipv6.c
@@ -2936,6 +2936,38 @@ int sfe_ipv6_create_rule(struct sfe_ipv6_rule_create_msg *msg)
 		}
 	}
 
+	if (disable_l2_flow) {
+		if (!reply_cm->top_interface_dev || is_vlan_dev(reply_cm->top_interface_dev)) {
+			reply_cm->flags |= SFE_IPV6_CONNECTION_MATCH_FLAG_WRITE_L2_HDR;
+
+			/*
+			 * If our dev writes Ethernet headers then we can write a really fast
+			 * version.
+			 */
+			if (src_dev->header_ops) {
+				if (src_dev->header_ops->create == eth_header) {
+					reply_cm->flags |= SFE_IPV6_CONNECTION_MATCH_FLAG_WRITE_FAST_ETH_HDR;
+				}
+			}
+		}
+	}
+
+	if (disable_l2_return) {
+		if (!original_cm->top_interface_dev || is_vlan_dev(original_cm->top_interface_dev)) {
+			original_cm->flags |= SFE_IPV6_CONNECTION_MATCH_FLAG_WRITE_L2_HDR;
+
+			/*
+			 * If our dev writes Ethernet headers then we can write a really fast
+			 * version.
+			 */
+			if (dest_dev->header_ops) {
+				if (dest_dev->header_ops->create == eth_header) {
+					original_cm->flags |= SFE_IPV6_CONNECTION_MATCH_FLAG_WRITE_FAST_ETH_HDR;
+				}
+			}
+		}
+	}
+
 #ifdef SFE_BRIDGE_VLAN_FILTERING_ENABLE
 	/*
 	 * Add Bridge VLAN Filter rule in reply_cm
-- 
