From 832218aa47c4b808d46c439831991bc1905226f8 Mon Sep 17 00:00:00 2001
From: Murat Sezgin <quic_msezgin@quicinc.com>
Date: Thu, 26 Sep 2024 13:10:14 +0530
Subject: [PATCH] Add support for various fixes in nss drivers

Signed-off-by: Deepak Kumar <quic_deepaku@quicinc.com>

--- a/sfe.c
+++ b/sfe.c
@@ -1026,7 +1026,8 @@ sfe_tx_status_t sfe_create_ipv4_rule_msg
 	if (!src_dev || !sfe_routed_dev_allow(src_dev, is_routed, true)) {
 		ret = SFE_CMN_RESPONSE_EINTERFACE;
 		sfe_incr_exceptions(SFE_EXCEPTION_SRC_DEV_NOT_L3);
-		goto failed_ret;
+		DEBUG_WARN("%p: SFE create: ingress SFE_EXCEPTION_SRC_DEV_NOT_L3 (%s)\n", msg, src_dev->name);
+		//goto failed_ret;
 	}
 
 	/*
@@ -1046,7 +1047,8 @@ sfe_tx_status_t sfe_create_ipv4_rule_msg
 	if (!dest_dev || !sfe_routed_dev_allow(dest_dev, is_routed, true)) {
 		ret = SFE_CMN_RESPONSE_EINTERFACE;
 		sfe_incr_exceptions(SFE_EXCEPTION_DEST_DEV_NOT_L3);
-		goto failed_ret;
+		DEBUG_WARN("%p: SFE create: egress SFE_EXCEPTION_DEST_DEV_NOT_L3 (%s)\n", msg, dest_dev->name);
+		//goto failed_ret;
 	}
 
 	/*
