+/* Sets mcast igmp exceptions. */
+void
+mcast_snooping_set_ipv4_exceptions(struct mcast_snooping *ms, struct mcast_ipv4_exception *exceptions,
+                                   unsigned int count)
+    OVS_REQ_WRLOCK(ms->rwlock)
+{
+    int i;
+    for (i = 0; i < count; i++) {
+        exceptions[i].addr &= exceptions[i].mask;
+    }
+
+    if (ms->ipv4_exceptions)
+        free(ms->ipv4_exceptions);
+    ms->ipv4_exceptions_count = count;
+    ms->ipv4_exceptions = exceptions;
+}
+
+/* Sets mcast mld exceptions. */
+void
+mcast_snooping_set_ipv6_exceptions(struct mcast_snooping *ms, struct mcast_ipv6_exception *exceptions,
+                                  unsigned int count)
+    OVS_REQ_WRLOCK(ms->rwlock)
+{
+    int i;
+    for (i = 0; i < count; i++) {
+        uint32_t *addr = exceptions[i].addr.__in6_union.__s6_addr32;
+        uint32_t *mask = exceptions[i].mask.__in6_union.__s6_addr32;
+        addr[0] &= mask[0];
+        addr[1] &= mask[1];
+        addr[2] &= mask[2];
+        addr[3] &= mask[3];
+    }
+
+    if (ms->ipv6_exceptions)
+        free(ms->ipv6_exceptions);
+    ms->ipv6_exceptions_count = count;
+    ms->ipv6_exceptions = exceptions;
+}
+
