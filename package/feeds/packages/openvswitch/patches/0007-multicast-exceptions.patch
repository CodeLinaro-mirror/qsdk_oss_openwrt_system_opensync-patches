+static int
+get_ch_count(char *str, char c)
+{
+    int i, count = 0;
+
+    for (i = 0; str[i] != '\0'; i++) {
+        if (str[i] == c)
+            count++;
+    }
+
+    return count;
+}
+
+static size_t
+parse_ipv4_exceptions(struct mcast_ipv4_exception **dest, char *input)
+{
+    int count = 0;
+    int address_count = get_ch_count(input, ',') + 1;
+    char *error = NULL;
+    char *new_str = strdup(input);
+    char *token = strtok(new_str, ",");
+    struct mcast_ipv4_exception *exceptions;
+
+    *dest = exceptions = malloc(sizeof(struct mcast_ipv4_exception) * address_count);
+    if (exceptions == NULL) {
+        free(new_str);
+        return 0;
+    }
+
+    while (token != NULL) {
+        error = ip_parse_masked(token, &exceptions[count].addr, &exceptions[count].mask);
+        token = strtok(NULL, ",");
+
+        if (error) {
+            free(error);
+            continue;
+        }
+        count++;
+    }
+
+    /* If no valid address was parsed (count == 0), we can free exceptions and return null. */
+    if (count < 1) {
+        free(exceptions);
+        *dest = NULL;
+    }
+
+    free(new_str);
+    return count;
+}
+
+static size_t
+parse_ipv6_exceptions(struct mcast_ipv6_exception **dest, char *input)
+{
+    int count = 0;
+    int address_count = get_ch_count(input, ',') + 1;
+    char *error = NULL;
+    char *new_str = strdup(input);
+    char *token = strtok(new_str, ",");
+    struct mcast_ipv6_exception *exceptions;
+
+    *dest = exceptions = malloc(sizeof(struct mcast_ipv6_exception) * address_count);
+    if (exceptions == NULL) {
+        free(new_str);
+        return 0;
+    }
+
+    while (token != NULL) {
+        error = ipv6_parse_masked(token, &exceptions[count].addr, &exceptions[count].mask);
+        token = strtok(NULL, ",");
+
+        if (error) {
+            free(error);
+            continue;
+        }
+        count++;
+    }
+
+    /* If no valid address was parsed (count == 0), we can free exceptions and return null. */
+    if (count < 1) {
+        free(exceptions);
+        *dest = NULL;
+    }
+
+    free(new_str);
+    return count;
+}
