+bool
+is_mcast_exception(const struct mcast_snooping *ms, struct flow *flow)
+    OVS_REQ_RDLOCK(ms->rwlock)
+{
+    int i;
+
+    if (get_dl_type(flow) == htons(ETH_TYPE_IP)) {
+        struct mcast_ipv4_exception *e;
+
+        for (i = 0; i < ms->ipv4_exceptions_count; i++) {
+            e = &ms->ipv4_exceptions[i];
+
+            if (e->addr == (flow->nw_dst & e->mask)) {
+                return true;
+            }
+        }
+    } else {
+        struct mcast_ipv6_exception *e;
+        uint32_t *addr;
+        uint32_t *mask;
+        uint32_t *dst_addr;
+
+        for (i = 0; i < ms->ipv6_exceptions_count; i++) {
+            e = &ms->ipv6_exceptions[i];
+            addr = e->addr.__in6_union.__s6_addr32;
+            mask = e->mask.__in6_union.__s6_addr32;
+            dst_addr = flow->ipv6_dst.__in6_union.__s6_addr32;
+
+            if (addr[0] == (dst_addr[0] & mask[0]) &&
+                addr[1] == (dst_addr[1] & mask[1]) &&
+                addr[2] == (dst_addr[2] & mask[2]) &&
+                addr[3] == (dst_addr[3] & mask[3])) {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
