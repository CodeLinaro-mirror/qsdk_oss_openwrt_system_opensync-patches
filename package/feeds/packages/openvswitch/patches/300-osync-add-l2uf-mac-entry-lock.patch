         break;
     case XC_FIN_TIMEOUT:
         if (stats->tcp_flags & (TCP_FIN | TCP_RST)) {
--- a/lib/dp-packet.h
+++ b/lib/dp-packet.h
@@ -1085,6 +1085,32 @@ dp_packet_l4_checksum_bad(const struct d
             DP_PACKET_OL_RX_L4_CKSUM_BAD;
 }
 
+static inline bool
+dp_packet_is_l2uf(const struct dp_packet *packet)
+{
+    if (packet == NULL) return false;
+    if (packet->packet_type != htonl(PT_ETH)) return false;
+
+    const unsigned char *data = dp_packet_data(packet);
+    const struct eth_addr *da = (const void *)data;
+    const ovs_be16 *type = (const void *)(data + (ETH_ADDR_LEN * 2));
+    uint32_t size = dp_packet_size(packet);
+
+    if (size < 20) return false;
+
+    while (size >= sizeof(*type) && eth_type_vlan(*type)) {
+        type += 1;
+        size -= sizeof(*type);
+    }
+
+    if (size < sizeof(*type)) return false;
+
+    const bool is_l2uf_normal = (ntohs(*type) == 6);
+    const bool is_l2uf_qca = (ntohs(*type) == 8);
+
+    return eth_addr_is_broadcast(*da) && (is_l2uf_normal || is_l2uf_qca);
+}
+
 #ifdef  __cplusplus
 }
 #endif
