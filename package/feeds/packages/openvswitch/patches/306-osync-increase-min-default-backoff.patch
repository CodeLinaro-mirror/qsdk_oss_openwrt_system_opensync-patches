--- a/lib/reconnect.c
+++ b/lib/reconnect.c
@@ -536,7 +536,7 @@ reconnect_deadline__(const struct reconn
         return fsm->state_entered + fsm->backoff;
 
     case S_CONNECTING:
-        return fsm->state_entered + MAX(1000, fsm->backoff);
+        return fsm->state_entered + MAX(4000, fsm->backoff);
 
     case S_ACTIVE:
         if (fsm->probe_interval) {
