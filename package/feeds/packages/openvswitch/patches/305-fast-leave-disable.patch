--- a/ofproto/ofproto.h
+++ b/ofproto/ofproto.h
@@ -195,6 +195,12 @@ struct ofproto_mcast_snooping_settings {
 
     struct mcast_ipv6_exception *ipv6_exceptions;
     size_t ipv6_exceptions_count;
+
+    unsigned int fast_leave_timeout;    /* When IGMP/MLD leave is received,
+                                         * entry is removed after
+                                         * fast_leave_timeout rather than
+                                         * instantly. Disabled if value is
+                                         * 0. */
 };
 
 struct ofproto_mcast_snooping_port_settings {
--- a/vswitchd/bridge.c
+++ b/vswitchd/bridge.c
@@ -2024,6 +2024,7 @@ bridge_configure_mcast_snooping(struct b
         br_s.max_entries = (max_entries
                             ? max_entries
                             : MCAST_DEFAULT_MAX_ENTRIES);
+        br_s.fast_leave_timeout = smap_get_int(oc, "mcast-snooping-fast-leave-timeout", 0);
 
         br_s.flood_unreg = !smap_get_bool(
             oc, "mcast-snooping-disable-flood-unregistered", false);
--- a/lib/mcast-snooping.h
+++ b/lib/mcast-snooping.h
@@ -154,6 +154,10 @@ struct mcast_snooping {
     struct mcast_ipv6_exception *ipv6_exceptions;
     size_t ipv6_exceptions_count;
 
+    /* Time in seconds to wait before removing bundle from group after
+     * receiving IGMP/MLD leave. If 0, timeout is disabled. */
+    unsigned int fast_leave_timeout;
+
     struct ovs_refcount ref_cnt;
     struct ovs_rwlock rwlock;
 };
@@ -183,6 +187,9 @@ void mcast_snooping_set_ipv6_exceptions(
                                         struct mcast_ipv6_exception *exceptions,
                                         unsigned int count)
     OVS_REQ_WRLOCK(ms->rwlock);
+void mcast_snooping_set_fast_leave_timeout(struct mcast_snooping *ms,
+                                           unsigned int timeout)
+    OVS_REQ_WRLOCK(ms->rwlock);
 void mcast_snooping_set_max_entries(struct mcast_snooping *ms,
                                     size_t max_entries)
     OVS_REQ_WRLOCK(ms->rwlock);
--- a/ofproto/ofproto-dpif.c
+++ b/ofproto/ofproto-dpif.c
@@ -3458,6 +3458,7 @@ set_mcast_snooping(struct ofproto *ofpro
         }
         mcast_snooping_set_ipv4_exceptions(ofproto->ms, s->ipv4_exceptions, s->ipv4_exceptions_count);
         mcast_snooping_set_ipv6_exceptions(ofproto->ms, s->ipv6_exceptions, s->ipv6_exceptions_count);
+        mcast_snooping_set_fast_leave_timeout(ofproto->ms, s->fast_leave_timeout);
         ovs_rwlock_unlock(&ofproto->ms->rwlock);
     } else {
         mcast_snooping_unref(ofproto->ms);
--- a/lib/mcast-snooping.c
+++ b/lib/mcast-snooping.c
@@ -150,6 +150,22 @@ group_get_lru(const struct mcast_snoopin
     }
 }
 
+/* If the LRU list is not empty, stores the least-recently-used entry
+ * in '*e' and returns true.  Otherwise, if the LRU list is empty,
+ * stores NULL in '*e' and return false. */
+static bool
+bundle_get_lru(const struct mcast_group *grp, struct mcast_group_bundle **b)
+    OVS_REQ_RDLOCK(ms->rwlock)
+{
+    if (!ovs_list_is_empty(&grp->bundle_lru)) {
+        *b = mcast_group_bundle_from_lru_node(grp->bundle_lru.next);
+        return true;
+    } else {
+        *b = NULL;
+        return false;
+    }
+}
+
 bool
 is_mcast_exception(const struct mcast_snooping *ms, struct flow *flow)
     OVS_REQ_RDLOCK(ms->rwlock)
@@ -221,6 +237,7 @@ mcast_snooping_create(void)
     ms->ipv4_exceptions_count = 0;
     ms->ipv6_exceptions = NULL;
     ms->ipv6_exceptions_count = 0;
+    ms->fast_leave_timeout = 0;
     ovs_refcount_init(&ms->ref_cnt);
     ovs_rwlock_init(&ms->rwlock);
     return ms;
@@ -314,6 +331,14 @@ mcast_snooping_set_ipv6_exceptions(struc
     ms->ipv6_exceptions = exceptions;
 }
 
+/* Sets mcast fast leave timeout of 'ms' to 'timeout' seconds. */
+void
+mcast_snooping_set_fast_leave_timeout(struct mcast_snooping *ms, unsigned int timeout)
+    OVS_REQ_WRLOCK(ms->rwlock)
+{
+    ms->fast_leave_timeout = timeout;
+}
+
 /* Sets the maximum number of entries in 'ms' to 'max_entries', adjusting it
  * to be within a reasonable range. */
 void
@@ -413,6 +438,81 @@ mcast_snooping_flush_group(struct mcast_
     ms->need_revalidate = true;
 }
 
+/* When fast leave is disabled, bundles are NOT immediately removed from mcast
+ * group, when query LEAVE message is received. Instead we set the bundle to
+ * expire in a few seconds (fast_leave_timeout), then reinsert them into the
+ * sorted list of bundles. */
+static void
+mcast_group_delay_delete_bundle(struct mcast_snooping *ms OVS_UNUSED,
+                                struct mcast_group *grp, void *port)
+    OVS_REQ_WRLOCK(ms->rwlock)
+{
+    struct mcast_group_bundle *b;
+    struct mcast_group *g;
+
+    /* First we need to find the bundle that got LEAVE message. */
+    struct mcast_group_bundle *leave_bundle = mcast_group_bundle_lookup(ms, grp, port);
+    if (leave_bundle == NULL) {
+        return;
+    }
+
+    /* Now change bundle expiration. */
+    leave_bundle->expires = time_now() + ms->fast_leave_timeout;
+
+    /* If group has only 1 element (this bundle), we are done sorting
+     * bundles. */
+    if (ovs_list_is_singleton(&grp->bundle_lru)) {
+        goto sort_groups;
+    }
+
+    /* Next we sort bundles within this group. First we remove the bundle from
+     * the group. */
+    ovs_list_remove(&leave_bundle->bundle_node);
+
+    /* Now we reinsert bundle back into sorted list. */
+    LIST_FOR_EACH (b, bundle_node, &grp->bundle_lru) {
+        if (b->expires >= leave_bundle->expires) {
+            ovs_list_insert(&b->bundle_node, &leave_bundle->bundle_node);
+            goto sort_groups;
+        }
+    }
+
+sort_groups:
+    /* If there is only 1 group in the table, we are done. */
+    if (ovs_list_is_singleton(&ms->group_lru)) {
+        return;
+    }
+
+    /* Remove group from table first. */
+    ovs_list_remove(&grp->group_node);
+
+    /* Reinsert group into the correct position in table. The first group in
+     * the list should have the bundle with the lowest expire value and the
+     * last group in the list should have the bundle with the biggest expire
+     * value. */
+    LIST_FOR_EACH (g, group_node, &ms->group_lru) {
+        /* Get the first bundle for each group (first bundle should have lowest
+         * expire value). */
+        if (!bundle_get_lru(g, &b)) {
+            continue;
+        }
+
+        /* If the bundle which received IGMP/MLD leave expires sooner than the
+         * first bundle of the current group, we need to insert our group
+         * before the current group. */
+        if (leave_bundle->expires <= b->expires) {
+            ovs_list_insert(&g->group_node, &grp->group_node);
+            return;
+        }
+    }
+
+    /* If we reached this point, all groups in the list must either have empty
+     * bundle lists or their bundles have lower expire times. Insert the group
+     * as the most recently used. */
+    ovs_list_push_back(&ms->group_lru, &grp->group_node);
+
+    return;
+}
 
 /* Delete bundle returning true if it succeeds,
  * false if it didn't find the group. */
@@ -661,10 +761,18 @@ mcast_snooping_leave_group(struct mcast_
     }
 
     grp = mcast_snooping_lookup(ms, addr, vlan);
+    if (!grp) return false;
+
+    if (ms->fast_leave_timeout > 0) {
+        mcast_group_delay_delete_bundle(ms, grp, port);
+        return false;
+    }
+
     if (grp && mcast_group_delete_bundle(ms, grp, port)) {
         ms->need_revalidate = true;
         return true;
     }
+
     return false;
 }
 
