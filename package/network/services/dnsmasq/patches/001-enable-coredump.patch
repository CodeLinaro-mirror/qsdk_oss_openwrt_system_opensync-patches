From a0e8048909cd96c0b4028c51cb4f9b78eda960e2 Mon Sep 17 00:00:00 2001
From: Atchaya R <quic_ratchaya@quicinc.com>
Date: Fri, 20 Sep 2024 09:59:44 +0530
Subject: [PATCH] openwrt patches for opensync

We heavily rely on logpull or remote environment for issue debugging.
Coredump always helps a lot for any user space APP crash issue.
Enable dnsmasq coredump by default

Signed-off-by: Atchaya R <quic_ratchaya@quicinc.com>


--- a/src/dnsmasq.c
+++ b/src/dnsmasq.c
@@ -669,8 +669,7 @@ int main (int argc, char **argv)
 #ifdef HAVE_LINUX_NETWORK
   free(hdr);
   free(data);
-  if (option_bool(OPT_DEBUG)) 
-    prctl(PR_SET_DUMPABLE, 1, 0, 0, 0);
+  prctl(PR_SET_DUMPABLE, 1, 0, 0, 0);
 #endif
 
 #ifdef HAVE_TFTP
