Author: Deepak kumar <quic_deepaku@quicinc.com>
Date: Tue Nov 19 13:37:15 2024

Improvements to script_call():
 - additional logging
 - kill entire script process group when already running

This should aleviate memory problems when running the script
in quick succesion and help to better understand the condition
when that is happening.

Signed-off-by: Deepak kumar <quic_deepaku@quicinc.com>

--- a/src/script.c
+++ b/src/script.c
@@ -51,8 +51,11 @@ static void script_sighandle(int signal)
 		pid_t child;
 
 		while ((child = waitpid(-1, NULL, WNOHANG)) > 0)
-			if (running == child)
+			if (running == child) {
+				time_t diff = odhcp6c_get_milli_time() / 1000 - started;
+				syslog(LOG_INFO, "script [%d] completed in %ld seconds", running, diff);
 				running = 0;
+			}
 	}
 }
 
@@ -405,7 +408,10 @@ void script_call(const char *status, int
 	if (running) {
 		time_t diff = now - started;
 
-		kill(running, SIGTERM);
+		syslog(LOG_WARNING, "script [%d] already running for %ld seconds, terminating", running, diff);
+		/* use negative pid (-running) to send signal to entire process group
+		 * that is the script and all it's child processes */
+		kill(-running, SIGTERM);
 
 		if (diff > delay)
 			delay -= diff;
@@ -421,6 +427,8 @@ void script_call(const char *status, int
 	pid_t pid = fork();
 
 	if (pid > 0) {
+		char *bname = strrchr(argv[0], '/');
+		syslog(LOG_INFO, "script [%d] started: %s %s %s", pid, bname ? bname+1 : argv[0], argv[1], argv[2]);
 		running = pid;
 		started = now;
 
